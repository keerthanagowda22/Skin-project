NODE_ENV=development
PORT=3000

# Google OAuth 2.0 Web client ID (configure an authorized origin such as
# http://localhost:3000 in Google Cloud Console before enabling Google sign-in).
GOOGLE_CLIENT_ID=

# Use Razorpay TEST credentials only. Never add secrets to browser JavaScript.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_secret

# Test-only shipping amount in paise (0 = no shipping charge in test mode).
SHIPPING_FEE_PAISE=0

# Optional path outside the public website for private SQLite order data.
# STORE_DB_PATH=
